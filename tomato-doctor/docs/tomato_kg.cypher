// Tomato Doctor knowledge graph - generated from tomatodoc/kg/seed/tomato_kg.json

CREATE CONSTRAINT crop_key IF NOT EXISTS FOR (n:Crop) REQUIRE n.crop_id IS UNIQUE;
CREATE CONSTRAINT disease_key IF NOT EXISTS FOR (n:Disease) REQUIRE n.disease_id IS UNIQUE;
CREATE CONSTRAINT symptom_key IF NOT EXISTS FOR (n:Symptom) REQUIRE n.symptom_id IS UNIQUE;
CREATE CONSTRAINT layterm_key IF NOT EXISTS FOR (n:LayTerm) REQUIRE n.term_id IS UNIQUE;
CREATE CONSTRAINT treatment_key IF NOT EXISTS FOR (n:Treatment) REQUIRE n.treatment_id IS UNIQUE;
CREATE CONSTRAINT confirmationimage_key IF NOT EXISTS FOR (n:ConfirmationImage) REQUIRE n.image_id IS UNIQUE;
CREATE CONSTRAINT seasoncondition_key IF NOT EXISTS FOR (n:SeasonCondition) REQUIRE n.condition_id IS UNIQUE;
MERGE (m:KGMeta {id:'meta'}) SET m.version="2.0.0", m.sources_json="{\"jagtap2025\": \"Jagtap, Shinde, Marade, Sawant, Sable, Mahalle (2025). A Comprehensive Dataset of Tomato Plant Diseases for National Predictive Analytics and Crop Health Management. Mendeley Data. DOI:10.17632/ztncd79yhk.1\", \"general\": \"General agricultural extension guidance (TNAU / standard plant-pathology practice). Verify locally with your agricultural officer or KVK.\"}";
MERGE (c:Crop {crop_id:"tomato"}) SET c.name_en="Tomato", c.name_ta="தக்காளி";
MERGE (s:SeasonCondition {condition_id:"humid_monsoon"}) SET s.name_en="Humid / Monsoon", s.name_ta="ஈரப்பதமான மழைக்காலம்", s.temp_range="22-30°C", s.humidity_range="80-100%", s.months=[7, 8, 9, 10, 11, 12];
MERGE (s:SeasonCondition {condition_id:"cool_moist"}) SET s.name_en="Cool & Misty", s.name_ta="குளிர் / பனிக்காலம்", s.temp_range="15-23°C", s.humidity_range="60-80%", s.months=[1, 2];
MERGE (s:SeasonCondition {condition_id:"hot_dry"}) SET s.name_en="Hot & Dry", s.name_ta="வெப்பமான வறண்ட காலம்", s.temp_range="30-40°C", s.humidity_range="20-50%", s.months=[3, 4, 5, 6];
MERGE (d:Disease {disease_id:"early_blight"}) SET d.name_en="Early Blight", d.name_ta="ஆரம்பகால இலைக் கருகல் நோய்", d.type="fungal", d.severity_scale=3, d.contagious=true, d.source="jagtap2025", d.summary_en="Fungal disease (Alternaria) that starts on older leaves as brown spots with target-like rings, then moves upward in warm, humid weather.", d.summary_ta="வெப்பமான, ஈரப்பதமான காலத்தில் வரும் பூஞ்சை நோய். கீழ் இலைகளில் வளையங்களுடன் கூடிய பழுப்புப் புள்ளிகளாகத் தொடங்கி மேல்நோக்கிப் பரவும்.", d.prevention_en=["Use certified, disease-free seed and healthy seedlings.", "Remove and destroy crop debris after harvest; rotate with non-solanaceous crops (beans, cabbage, cereals).", "Avoid overhead irrigation; space plants for good air flow."], d.prevention_ta=["சான்றளிக்கப்பட்ட, நோயற்ற விதைகள் மற்றும் ஆரோக்கியமான நாற்றுகளைப் பயன்படுத்தவும்.", "அறுவடைக்குப் பின் செடிக் கழிவுகளை அழிக்கவும்; பீன்ஸ், முட்டைக்கோஸ், தானியங்கள் போன்ற பயிர்களுடன் பயிர் சுழற்சி செய்யவும்.", "மேலிருந்து தண்ணீர் தெளிப்பதைத் தவிர்க்கவும்; காற்றோட்டத்திற்கு இடைவெளி விட்டு நடவும்."], d.images=["early_blight_1.jpg", "early_blight_2.jpg", "early_blight_3.jpg"];
MATCH (c:Crop {crop_id:"tomato"}), (d:Disease {disease_id:"early_blight"}) MERGE (c)-[:SUSCEPTIBLE_TO]->(d);
MATCH (d:Disease {disease_id:"early_blight"}), (s:SeasonCondition {condition_id:"humid_monsoon"}) MERGE (d)-[f:FAVORED_BY]->(s) SET f.boost=0.7;
MATCH (d:Disease {disease_id:"early_blight"}) MERGE (i:ConfirmationImage {image_id:"img_early_blight_1"}) SET i.url="/static/img/diseases/early_blight_1.jpg", i.disease_id="early_blight", i.verified_count=coalesce(i.verified_count,0) MERGE (d)-[:CONFIRMED_BY]->(i);
MATCH (d:Disease {disease_id:"early_blight"}) MERGE (i:ConfirmationImage {image_id:"img_early_blight_2"}) SET i.url="/static/img/diseases/early_blight_2.jpg", i.disease_id="early_blight", i.verified_count=coalesce(i.verified_count,0) MERGE (d)-[:CONFIRMED_BY]->(i);
MATCH (d:Disease {disease_id:"early_blight"}) MERGE (i:ConfirmationImage {image_id:"img_early_blight_3"}) SET i.url="/static/img/diseases/early_blight_3.jpg", i.disease_id="early_blight", i.verified_count=coalesce(i.verified_count,0) MERGE (d)-[:CONFIRMED_BY]->(i);
MERGE (d:Disease {disease_id:"late_blight"}) SET d.name_en="Late Blight", d.name_ta="பின்பருவ இலைக் கருகல் நோய்", d.type="fungal", d.severity_scale=5, d.contagious=true, d.source="jagtap2025", d.summary_en="Very destructive water-mould disease. Large dark, water-soaked patches with white growth underneath; can destroy a field within days in cool, wet weather.", d.summary_ta="மிக வேகமாக அழிக்கும் நோய். இலையில் நனைந்தது போன்ற பெரிய கருமையான திட்டுகள், அடியில் வெள்ளை பூஞ்சை. குளிர்ந்த, ஈரமான காலத்தில் சில நாட்களில் வயல் முழுவதும் பரவும்.", d.prevention_en=["Do not grow tomato next to potato.", "Rotate crops for 2–3 years with non-host plants.", "Irrigate at ground level and not late in the day; disinfect field tools."], d.prevention_ta=["உருளைக்கிழங்கு அருகே தக்காளி பயிரிட வேண்டாம்.", "2–3 ஆண்டுகள் வேறு பயிர்களுடன் பயிர் சுழற்சி செய்யவும்.", "மாலை நேரத்தில் நீர் பாய்ச்ச வேண்டாம்; வேர்ப்பகுதியில் மட்டும் நீர் பாய்ச்சவும்; கருவிகளைச் சுத்தம் செய்யவும்."], d.images=["late_blight_1.jpg", "late_blight_2.jpg", "late_blight_3.jpg"];
MATCH (c:Crop {crop_id:"tomato"}), (d:Disease {disease_id:"late_blight"}) MERGE (c)-[:SUSCEPTIBLE_TO]->(d);
MATCH (d:Disease {disease_id:"late_blight"}), (s:SeasonCondition {condition_id:"humid_monsoon"}) MERGE (d)-[f:FAVORED_BY]->(s) SET f.boost=0.9;
MATCH (d:Disease {disease_id:"late_blight"}), (s:SeasonCondition {condition_id:"cool_moist"}) MERGE (d)-[f:FAVORED_BY]->(s) SET f.boost=0.8;
MATCH (d:Disease {disease_id:"late_blight"}) MERGE (i:ConfirmationImage {image_id:"img_late_blight_1"}) SET i.url="/static/img/diseases/late_blight_1.jpg", i.disease_id="late_blight", i.verified_count=coalesce(i.verified_count,0) MERGE (d)-[:CONFIRMED_BY]->(i);
MATCH (d:Disease {disease_id:"late_blight"}) MERGE (i:ConfirmationImage {image_id:"img_late_blight_2"}) SET i.url="/static/img/diseases/late_blight_2.jpg", i.disease_id="late_blight", i.verified_count=coalesce(i.verified_count,0) MERGE (d)-[:CONFIRMED_BY]->(i);
MATCH (d:Disease {disease_id:"late_blight"}) MERGE (i:ConfirmationImage {image_id:"img_late_blight_3"}) SET i.url="/static/img/diseases/late_blight_3.jpg", i.disease_id="late_blight", i.verified_count=coalesce(i.verified_count,0) MERGE (d)-[:CONFIRMED_BY]->(i);
MERGE (d:Disease {disease_id:"powdery_mildew"}) SET d.name_en="Powdery Mildew", d.name_ta="சாம்பல் நோய் (வெள்ளைப் பூஞ்சை)", d.type="fungal", d.severity_scale=2, d.contagious=true, d.source="general", d.summary_en="White powdery fungal growth on the leaf surface; leaves turn yellow and dry in severe cases. Common with dry days and cool nights.", d.summary_ta="இலைகளில் வெள்ளைத் தூள் போன்ற பூஞ்சை வளர்ச்சி; தீவிரமானால் இலைகள் மஞ்சளாகி காய்ந்துவிடும்.", d.prevention_en=["Space plants well and remove badly affected leaves.", "Avoid excess nitrogen fertilizer.", "Start sulfur or neem sprays at the first sign."], d.prevention_ta=["செடிகளுக்கு இடையே போதுமான இடைவெளி விட்டு, அதிகம் பாதித்த இலைகளை அகற்றவும்.", "அதிக தழைச்சத்து (யூரியா) உரம் இடுவதைத் தவிர்க்கவும்.", "முதல் அறிகுறி தெரிந்தவுடனே கந்தகம் / வேப்ப எண்ணெய் தெளிக்கத் தொடங்கவும்."], d.images=[];
MATCH (c:Crop {crop_id:"tomato"}), (d:Disease {disease_id:"powdery_mildew"}) MERGE (c)-[:SUSCEPTIBLE_TO]->(d);
MATCH (d:Disease {disease_id:"powdery_mildew"}), (s:SeasonCondition {condition_id:"cool_moist"}) MERGE (d)-[f:FAVORED_BY]->(s) SET f.boost=0.7;
MATCH (d:Disease {disease_id:"powdery_mildew"}), (s:SeasonCondition {condition_id:"hot_dry"}) MERGE (d)-[f:FAVORED_BY]->(s) SET f.boost=0.5;
MERGE (d:Disease {disease_id:"whitefly"}) SET d.name_en="Whitefly Infestation", d.name_ta="வெள்ளை ஈ தாக்குதல்", d.type="pest", d.severity_scale=3, d.contagious=false, d.source="general", d.summary_en="Tiny white sap-sucking insects under the leaves. They weaken plants, leave sticky honeydew and spread Leaf Curl Virus — control them early.", d.summary_ta="இலையின் அடியில் சாறு உறிஞ்சும் சிறிய வெள்ளைப் பூச்சிகள். செடியை பலவீனமாக்கி, ஒட்டும் திரவத்தை விட்டு, இலைச் சுருள் வைரஸையும் பரப்பும் — ஆரம்பத்திலேயே கட்டுப்படுத்தவும்.", d.prevention_en=["Raise seedlings under insect-proof net.", "Install yellow sticky traps from planting.", "Remove weed hosts around the field."], d.prevention_ta=["பூச்சி புகா வலையின் கீழ் நாற்றுகளை வளர்க்கவும்.", "நடவு முதலே மஞ்சள் ஒட்டும் பொறிகளை வைக்கவும்.", "வயலைச் சுற்றியுள்ள களைச் செடிகளை அகற்றவும்."], d.images=[];
MATCH (c:Crop {crop_id:"tomato"}), (d:Disease {disease_id:"whitefly"}) MERGE (c)-[:SUSCEPTIBLE_TO]->(d);
MATCH (d:Disease {disease_id:"whitefly"}), (s:SeasonCondition {condition_id:"hot_dry"}) MERGE (d)-[f:FAVORED_BY]->(s) SET f.boost=0.8;
MERGE (d:Disease {disease_id:"leaf_curl_virus"}) SET d.name_en="Tomato Leaf Curl Virus", d.name_ta="இலைச் சுருள் நோய் (வைரஸ்)", d.type="viral", d.severity_scale=4, d.contagious=true, d.source="jagtap2025", d.summary_en="Virus spread by whiteflies. Young leaves curl upward, turn yellow and small; plants become stunted and bushy with few fruits. Infected plants cannot be cured.", d.summary_ta="வெள்ளை ஈ மூலம் பரவும் வைரஸ். இளம் இலைகள் மேல்நோக்கிச் சுருண்டு, மஞ்சளாகி, சிறியதாகும்; செடி குட்டையாகி காய்ப்பு குறையும். பாதித்த செடியைக் குணப்படுத்த முடியாது.", d.prevention_en=["Use resistant varieties (Ty genes) and virus-free seedlings.", "Control whiteflies early — nets in the nursery, sticky traps in the field.", "Pull out and destroy infected plants early in the season."], d.prevention_ta=["நோய் எதிர்ப்பு ரகங்கள் மற்றும் வைரஸ் இல்லாத நாற்றுகளைப் பயன்படுத்தவும்.", "வெள்ளை ஈயை ஆரம்பத்திலேயே கட்டுப்படுத்தவும் — நாற்றங்காலில் வலை, வயலில் ஒட்டும் பொறிகள்.", "பாதிக்கப்பட்ட செடிகளை ஆரம்பத்திலேயே பிடுங்கி அழிக்கவும்."], d.images=["leaf_curl_virus_1.jpg", "leaf_curl_virus_2.jpg", "leaf_curl_virus_3.jpg"];
MATCH (c:Crop {crop_id:"tomato"}), (d:Disease {disease_id:"leaf_curl_virus"}) MERGE (c)-[:SUSCEPTIBLE_TO]->(d);
MATCH (d:Disease {disease_id:"leaf_curl_virus"}), (s:SeasonCondition {condition_id:"hot_dry"}) MERGE (d)-[f:FAVORED_BY]->(s) SET f.boost=0.7;
MATCH (d:Disease {disease_id:"leaf_curl_virus"}) MERGE (i:ConfirmationImage {image_id:"img_leaf_curl_virus_1"}) SET i.url="/static/img/diseases/leaf_curl_virus_1.jpg", i.disease_id="leaf_curl_virus", i.verified_count=coalesce(i.verified_count,0) MERGE (d)-[:CONFIRMED_BY]->(i);
MATCH (d:Disease {disease_id:"leaf_curl_virus"}) MERGE (i:ConfirmationImage {image_id:"img_leaf_curl_virus_2"}) SET i.url="/static/img/diseases/leaf_curl_virus_2.jpg", i.disease_id="leaf_curl_virus", i.verified_count=coalesce(i.verified_count,0) MERGE (d)-[:CONFIRMED_BY]->(i);
MATCH (d:Disease {disease_id:"leaf_curl_virus"}) MERGE (i:ConfirmationImage {image_id:"img_leaf_curl_virus_3"}) SET i.url="/static/img/diseases/leaf_curl_virus_3.jpg", i.disease_id="leaf_curl_virus", i.verified_count=coalesce(i.verified_count,0) MERGE (d)-[:CONFIRMED_BY]->(i);
MERGE (d:Disease {disease_id:"septoria_leaf_spot"}) SET d.name_en="Septoria Leaf Spot", d.name_ta="செப்டோரியா இலைப்புள்ளி நோய்", d.type="fungal", d.severity_scale=3, d.contagious=true, d.source="jagtap2025", d.summary_en="Many small round spots with grey centres and dark borders on the lower leaves, often with tiny black dots inside. Leaves turn yellow and drop.", d.summary_ta="கீழ் இலைகளில் சாம்பல் நடுப்பகுதி, கருப்பு ஓரம் கொண்ட பல சிறிய வட்டப் புள்ளிகள்; உள்ளே சிறிய கருப்புப் பொட்டுகள். இலைகள் மஞ்சளாகி உதிரும்.", d.prevention_en=["Remove infected lower leaves early; destroy debris at season end (do not compost).", "Use drip irrigation and water early in the day.", "Control nightshade weeds; sanitize stakes and tools."], d.prevention_ta=["பாதித்த கீழ் இலைகளை ஆரம்பத்திலேயே அகற்றவும்; பருவ இறுதியில் கழிவுகளை அழிக்கவும் (உரமாக்க வேண்டாம்).", "சொட்டு நீர்ப் பாசனம் செய்து, காலையில் நீர் பாய்ச்சவும்.", "மணத்தக்காளி போன்ற களைகளை அகற்றவும்; குச்சிகள், கருவிகளைச் சுத்தம் செய்யவும்."], d.images=["septoria_leaf_spot_1.jpg", "septoria_leaf_spot_2.jpg", "septoria_leaf_spot_3.jpg"];
MATCH (c:Crop {crop_id:"tomato"}), (d:Disease {disease_id:"septoria_leaf_spot"}) MERGE (c)-[:SUSCEPTIBLE_TO]->(d);
MATCH (d:Disease {disease_id:"septoria_leaf_spot"}), (s:SeasonCondition {condition_id:"cool_moist"}) MERGE (d)-[f:FAVORED_BY]->(s) SET f.boost=0.8;
MATCH (d:Disease {disease_id:"septoria_leaf_spot"}), (s:SeasonCondition {condition_id:"humid_monsoon"}) MERGE (d)-[f:FAVORED_BY]->(s) SET f.boost=0.6;
MATCH (d:Disease {disease_id:"septoria_leaf_spot"}) MERGE (i:ConfirmationImage {image_id:"img_septoria_leaf_spot_1"}) SET i.url="/static/img/diseases/septoria_leaf_spot_1.jpg", i.disease_id="septoria_leaf_spot", i.verified_count=coalesce(i.verified_count,0) MERGE (d)-[:CONFIRMED_BY]->(i);
MATCH (d:Disease {disease_id:"septoria_leaf_spot"}) MERGE (i:ConfirmationImage {image_id:"img_septoria_leaf_spot_2"}) SET i.url="/static/img/diseases/septoria_leaf_spot_2.jpg", i.disease_id="septoria_leaf_spot", i.verified_count=coalesce(i.verified_count,0) MERGE (d)-[:CONFIRMED_BY]->(i);
MATCH (d:Disease {disease_id:"septoria_leaf_spot"}) MERGE (i:ConfirmationImage {image_id:"img_septoria_leaf_spot_3"}) SET i.url="/static/img/diseases/septoria_leaf_spot_3.jpg", i.disease_id="septoria_leaf_spot", i.verified_count=coalesce(i.verified_count,0) MERGE (d)-[:CONFIRMED_BY]->(i);
MERGE (d:Disease {disease_id:"bacterial_spot"}) SET d.name_en="Bacterial Spot", d.name_ta="பாக்டீரியா இலைப்புள்ளி நோய்", d.type="bacterial", d.severity_scale=3, d.contagious=true, d.source="general", d.summary_en="Small dark water-soaked leaf spots that turn scabby, often with yellow halos; raised scabby spots on fruit. Spreads by rain splash.", d.summary_ta="இலைகளில் சிறிய கருமையான நனைந்த புள்ளிகள், சுற்றி மஞ்சள் வளையம்; பழத்தில் சொரசொரப்பான மேடான புள்ளிகள். மழைத் தெறிப்பால் பரவும்.", d.prevention_en=["Use disease-free seed and transplants.", "Avoid working in the field when plants are wet.", "Rotate crops and remove infected debris."], d.prevention_ta=["நோயற்ற விதை மற்றும் நாற்றுகளைப் பயன்படுத்தவும்.", "செடிகள் ஈரமாக இருக்கும்போது வயலில் வேலை செய்ய வேண்டாம்.", "பயிர் சுழற்சி செய்து, பாதித்த கழிவுகளை அகற்றவும்."], d.images=["bacterial_spot_1.jpg", "bacterial_spot_2.jpg", "bacterial_spot_3.jpg"];
MATCH (c:Crop {crop_id:"tomato"}), (d:Disease {disease_id:"bacterial_spot"}) MERGE (c)-[:SUSCEPTIBLE_TO]->(d);
MATCH (d:Disease {disease_id:"bacterial_spot"}), (s:SeasonCondition {condition_id:"humid_monsoon"}) MERGE (d)-[f:FAVORED_BY]->(s) SET f.boost=0.7;
