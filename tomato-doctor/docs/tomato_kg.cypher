MATCH (d:Disease {disease_id:"bacterial_spot"}) MERGE (i:ConfirmationImage {image_id:"img_bacterial_spot_2"}) SET i.url="/static/img/diseases/bacterial_spot_2.jpg", i.disease_id="bacterial_spot", i.verified_count=coalesce(i.verified_count,0) MERGE (d)-[:CONFIRMED_BY]->(i);
MATCH (d:Disease {disease_id:"bacterial_spot"}) MERGE (i:ConfirmationImage {image_id:"img_bacterial_spot_3"}) SET i.url="/static/img/diseases/bacterial_spot_3.jpg", i.disease_id="bacterial_spot", i.verified_count=coalesce(i.verified_count,0) MERGE (d)-[:CONFIRMED_BY]->(i);
MERGE (d:Disease {disease_id:"fusarium_wilt"}) SET d.name_en="Fusarium Wilt", d.name_ta="ஃபியூசேரியம் வாடல் நோய்", d.type="fungal", d.severity_scale=4, d.contagious=true, d.source="general", d.summary_en="Soil-borne fungus blocks the plant's water flow. Wilting starts on one side or one branch with yellow lower leaves; the stem shows brown streaks inside.", d.summary_ta="மண்ணில் வாழும் பூஞ்சை நீர் ஓட்டத்தைத் தடுக்கும். ஒரு பக்கம் / ஒரு கிளையில் வாடல் தொடங்கி, கீழ் இலைகள் மஞ்சளாகும்; தண்டின் உள்ளே பழுப்புக் கோடுகள்.", d.prevention_en=["Grow resistant varieties.", "Rotate with non-solanaceous crops for 2–3 seasons.", "Solarize the soil in summer before planting."], d.prevention_ta=["நோய் எதிர்ப்பு ரகங்களைப் பயிரிடவும்.", "2–3 பருவங்கள் கத்தரி, மிளகாய் அல்லாத பயிர்களுடன் சுழற்சி செய்யவும்.", "நடவுக்கு முன் கோடையில் மண்ணை சூரிய வெப்பத்தால் சுத்திகரிக்கவும் (பிளாஸ்டிக் போர்த்துதல்)."], d.images=[];
MATCH (c:Crop {crop_id:"tomato"}), (d:Disease {disease_id:"fusarium_wilt"}) MERGE (c)-[:SUSCEPTIBLE_TO]->(d);
MATCH (d:Disease {disease_id:"fusarium_wilt"}), (s:SeasonCondition {condition_id:"hot_dry"}) MERGE (d)-[f:FAVORED_BY]->(s) SET f.boost=0.6;
MERGE (d:Disease {disease_id:"bacterial_wilt"}) SET d.name_en="Bacterial Wilt", d.name_ta="பாக்டீரியா வாடல் நோய்", d.type="bacterial", d.severity_scale=5, d.contagious=true, d.source="general", d.summary_en="The whole plant wilts suddenly while leaves are still green. A cut stem placed in water releases milky white ooze. There is no cure — remove plants quickly.", d.summary_ta="இலைகள் பச்சையாக இருக்கும்போதே செடி முழுவதும் திடீரென வாடும். வெட்டிய தண்டை நீரில் வைத்தால் பால் போன்ற வெள்ளைக் கசிவு வரும். மருந்து இல்லை — செடியை உடனே அகற்றவும்.", d.prevention_en=["Remove wilted plants with their roots immediately and destroy them.", "Rotate with non-host crops (cereals); avoid fields that had wilt before.", "Avoid waterlogging and root injury; grow resistant varieties."], d.prevention_ta=["வாடிய செடிகளை வேருடன் உடனே பிடுங்கி அழிக்கவும்.", "தானியப் பயிர்களுடன் சுழற்சி செய்யவும்; முன்பு வாடல் வந்த வயலைத் தவிர்க்கவும்.", "நீர் தேங்குவதையும் வேர் காயத்தையும் தவிர்க்கவும்; எதிர்ப்பு ரகங்களைப் பயிரிடவும்."], d.images=[];
MATCH (c:Crop {crop_id:"tomato"}), (d:Disease {disease_id:"bacterial_wilt"}) MERGE (c)-[:SUSCEPTIBLE_TO]->(d);
MATCH (d:Disease {disease_id:"bacterial_wilt"}), (s:SeasonCondition {condition_id:"humid_monsoon"}) MERGE (d)-[f:FAVORED_BY]->(s) SET f.boost=0.8;
MERGE (d:Disease {disease_id:"blossom_end_rot"}) SET d.name_en="Blossom End Rot", d.name_ta="பூ முனை அழுகல்", d.type="physiological", d.severity_scale=3, d.contagious=false, d.source="general", d.summary_en="Not an infection — caused by calcium shortage in the fruit, usually from uneven watering. Dark, sunken, leathery patch at the bottom of the fruit.", d.summary_ta="இது தொற்று நோய் அல்ல — சீரற்ற நீர்ப் பாசனத்தால் பழத்தில் கால்சியம் குறைவதால் வருவது. பழத்தின் அடியில் கருப்பான, குழிந்த, தோல் போன்ற திட்டு.", d.prevention_en=["Water evenly; mulch to keep soil moisture steady.", "Avoid excess nitrogen; apply lime or gypsum if soil calcium is low (test the soil).", "Remove affected fruits."], d.prevention_ta=["சீராக நீர் பாய்ச்சவும்; மண் ஈரப்பதம் நிலைக்க மூடாக்கு இடவும்.", "அதிக தழைச்சத்தைத் தவிர்க்கவும்; மண்ணில் கால்சியம் குறைவாக இருந்தால் சுண்ணாம்பு / ஜிப்சம் இடவும் (மண் பரிசோதனை செய்யவும்).", "பாதித்த பழங்களை அகற்றவும்."], d.images=[];
MATCH (c:Crop {crop_id:"tomato"}), (d:Disease {disease_id:"blossom_end_rot"}) MERGE (c)-[:SUSCEPTIBLE_TO]->(d);
MATCH (d:Disease {disease_id:"blossom_end_rot"}), (s:SeasonCondition {condition_id:"hot_dry"}) MERGE (d)-[f:FAVORED_BY]->(s) SET f.boost=0.7;
MERGE (d:Disease {disease_id:"mosaic_virus"}) SET d.name_en="Tomato Mosaic Virus", d.name_ta="தேமல் நோய் (மொசைக் வைரஸ்)", d.type="viral", d.severity_scale=3, d.contagious=true, d.source="jagtap2025", d.summary_en="Virus spread by touch, tools and seed. Leaves show light/dark green mottling and may be twisted; fruits ripen unevenly. Fungicides do not work on it.", d.summary_ta="கை, கருவிகள், விதை மூலம் பரவும் வைரஸ். இலைகளில் வெளிர் / கரும்பச்சை தேமல், இலை முறுக்கம்; பழங்கள் சீராகப் பழுக்காது. பூஞ்சைக் கொல்லிகள் பயன் தராது.", d.prevention_en=["Wash hands and tools with soap while working; do not handle tobacco near plants.", "Do not save seed from infected plants; treat seed with 1% sodium hypochlorite.", "Remove volunteer tomato and nightshade weeds."], d.prevention_ta=["வேலை செய்யும்போது கைகள், கருவிகளை சோப்பால் கழுவவும்; செடிகள் அருகே புகையிலை பயன்படுத்த வேண்டாம்.", "பாதித்த செடிகளிலிருந்து விதை சேமிக்க வேண்டாம்; 1% சோடியம் ஹைப்போகுளோரைட்டில் விதை நேர்த்தி செய்யவும்.", "தானாக முளைத்த தக்காளி, மணத்தக்காளி களைகளை அகற்றவும்."], d.images=["mosaic_virus_1.jpg", "mosaic_virus_2.jpg", "mosaic_virus_3.jpg"];
MATCH (c:Crop {crop_id:"tomato"}), (d:Disease {disease_id:"mosaic_virus"}) MERGE (c)-[:SUSCEPTIBLE_TO]->(d);
MATCH (d:Disease {disease_id:"mosaic_virus"}) MERGE (i:ConfirmationImage {image_id:"img_mosaic_virus_1"}) SET i.url="/static/img/diseases/mosaic_virus_1.jpg", i.disease_id="mosaic_virus", i.verified_count=coalesce(i.verified_count,0) MERGE (d)-[:CONFIRMED_BY]->(i);
MATCH (d:Disease {disease_id:"mosaic_virus"}) MERGE (i:ConfirmationImage {image_id:"img_mosaic_virus_2"}) SET i.url="/static/img/diseases/mosaic_virus_2.jpg", i.disease_id="mosaic_virus", i.verified_count=coalesce(i.verified_count,0) MERGE (d)-[:CONFIRMED_BY]->(i);
MATCH (d:Disease {disease_id:"mosaic_virus"}) MERGE (i:ConfirmationImage {image_id:"img_mosaic_virus_3"}) SET i.url="/static/img/diseases/mosaic_virus_3.jpg", i.disease_id="mosaic_virus", i.verified_count=coalesce(i.verified_count,0) MERGE (d)-[:CONFIRMED_BY]->(i);
MERGE (d:Disease {disease_id:"spider_mite"}) SET d.name_en="Two-Spotted Spider Mite", d.name_ta="சிலந்திப் பேன்", d.type="pest", d.severity_scale=3, d.contagious=false, d.source="jagtap2025", d.summary_en="Tiny mites under the leaves suck sap, causing fine yellow speckles, bronzing and fine webbing. Worst in hot, dry, dusty weather.", d.summary_ta="இலையின் அடியில் உள்ள மிகச் சிறிய பேன்கள் சாறு உறிஞ்சுவதால் மஞ்சள் பொட்டுகள், வெண்கல நிறம், மெல்லிய வலை ஏற்படும். வெப்பமான, வறண்ட காலத்தில் அதிகம்.", d.prevention_en=["Avoid water stress — water regularly.", "Avoid excess nitrogen fertilizer.", "Check leaf undersides weekly in hot, dry weather."], d.prevention_ta=["நீர்ப் பற்றாக்குறை வராமல் தொடர்ந்து நீர் பாய்ச்சவும்.", "அதிக தழைச்சத்து உரத்தைத் தவிர்க்கவும்.", "வெப்பமான காலத்தில் வாரந்தோறும் இலையின் அடிப்பகுதியைச் சோதிக்கவும்."], d.images=["spider_mite_1.jpg", "spider_mite_2.jpg", "spider_mite_3.jpg"];
MATCH (c:Crop {crop_id:"tomato"}), (d:Disease {disease_id:"spider_mite"}) MERGE (c)-[:SUSCEPTIBLE_TO]->(d);
MATCH (d:Disease {disease_id:"spider_mite"}), (s:SeasonCondition {condition_id:"hot_dry"}) MERGE (d)-[f:FAVORED_BY]->(s) SET f.boost=0.9;
MATCH (d:Disease {disease_id:"spider_mite"}) MERGE (i:ConfirmationImage {image_id:"img_spider_mite_1"}) SET i.url="/static/img/diseases/spider_mite_1.jpg", i.disease_id="spider_mite", i.verified_count=coalesce(i.verified_count,0) MERGE (d)-[:CONFIRMED_BY]->(i);
MATCH (d:Disease {disease_id:"spider_mite"}) MERGE (i:ConfirmationImage {image_id:"img_spider_mite_2"}) SET i.url="/static/img/diseases/spider_mite_2.jpg", i.disease_id="spider_mite", i.verified_count=coalesce(i.verified_count,0) MERGE (d)-[:CONFIRMED_BY]->(i);
MATCH (d:Disease {disease_id:"spider_mite"}) MERGE (i:ConfirmationImage {image_id:"img_spider_mite_3"}) SET i.url="/static/img/diseases/spider_mite_3.jpg", i.disease_id="spider_mite", i.verified_count=coalesce(i.verified_count,0) MERGE (d)-[:CONFIRMED_BY]->(i);
MERGE (d:Disease {disease_id:"fruit_borer"}) SET d.name_en="Fruit Borer", d.name_ta="காய்ப்புழு (காய்த் துளைப்பான்)", d.type="pest", d.severity_scale=4, d.contagious=false, d.source="general", d.summary_en="Caterpillars (Helicoverpa) bore round holes into fruits and feed inside, making them unmarketable.", d.summary_ta="புழுக்கள் (ஹெலிகோவெர்பா) காய்களில் வட்டத் துளையிட்டு உள்ளே தின்று, காய்களை விற்பனைக்குத் தகுதியற்றதாக்கும்.", d.prevention_en=["Install pheromone traps to monitor moths.", "Collect and destroy bored fruits regularly.", "Grow marigold as a trap crop along the borders."], d.prevention_ta=["அந்துப்பூச்சிகளைக் கண்காணிக்க இனக்கவர்ச்சிப் பொறிகளை வைக்கவும்.", "துளையுள்ள காய்களைத் தொடர்ந்து சேகரித்து அழிக்கவும்.", "வரப்பில் செண்டுமல்லியைக் கவர்ச்சிப் பயிராக வளர்க்கவும்."], d.images=[];
MATCH (c:Crop {crop_id:"tomato"}), (d:Disease {disease_id:"fruit_borer"}) MERGE (c)-[:SUSCEPTIBLE_TO]->(d);
MERGE (d:Disease {disease_id:"root_knot_nematode"}) SET d.name_en="Root-Knot Nematode", d.name_ta="வேர் முடிச்சு நூற்புழு", d.type="pest", d.severity_scale=3, d.contagious=false, d.source="general", d.summary_en="Microscopic worms in the soil form knots (galls) on the roots. Plants are stunted, yellow and wilt in the afternoon even with enough water.", d.summary_ta="மண்ணில் உள்ள கண்ணுக்குத் தெரியாத புழுக்கள் வேரில் முடிச்சுகளை உண்டாக்கும். போதுமான நீர் இருந்தும் செடி குட்டையாகி, மஞ்சளாகி, மதியம் வாடும்.", d.prevention_en=["Solarize the soil before planting.", "Rotate with non-host crops (e.g., cereals, marigold).", "Use nematode-free nursery soil."], d.prevention_ta=["நடவுக்கு முன் மண்ணை சூரிய வெப்பத்தால் சுத்திகரிக்கவும்.", "தானியங்கள், செண்டுமல்லி போன்ற பயிர்களுடன் சுழற்சி செய்யவும்.", "நூற்புழு இல்லாத நாற்றங்கால் மண்ணைப் பயன்படுத்தவும்."], d.images=[];
MATCH (c:Crop {crop_id:"tomato"}), (d:Disease {disease_id:"root_knot_nematode"}) MERGE (c)-[:SUSCEPTIBLE_TO]->(d);
MERGE (d:Disease {disease_id:"leaf_miner"}) SET d.name_en="Leaf Miner", d.name_ta="இலைச் சுரங்கப் புழு", d.type="pest", d.severity_scale=3, d.contagious=false, d.source="jagtap2025", d.summary_en="Tiny larvae tunnel inside the leaves, leaving winding white/brown lines. Heavy attack dries the leaves and reduces yield.", d.summary_ta="சிறிய புழுக்கள் இலைக்குள் சுரங்கம் அமைத்து, வளைந்த வெள்ளை / பழுப்புக் கோடுகளை உண்டாக்கும். அதிகமானால் இலைகள் காய்ந்து மகசூல் குறையும்.", d.prevention_en=["Collect and destroy mined leaves.", "Use yellow sticky traps for early detection.", "Spray neem oil; avoid overusing chemical pesticides (they kill natural enemies)."], d.prevention_ta=["சுரங்கம் உள்ள இலைகளைச் சேகரித்து அழிக்கவும்.", "ஆரம்பத்திலேயே கண்டறிய மஞ்சள் ஒட்டும் பொறிகளை வைக்கவும்.", "வேப்ப எண்ணெய் தெளிக்கவும்; ரசாயன மருந்துகளை அளவுக்கு மீறிப் பயன்படுத்த வேண்டாம்."], d.images=[];
MATCH (c:Crop {crop_id:"tomato"}), (d:Disease {disease_id:"leaf_miner"}) MERGE (c)-[:SUSCEPTIBLE_TO]->(d);
MATCH (d:Disease {disease_id:"leaf_miner"}), (s:SeasonCondition {condition_id:"humid_monsoon"}) MERGE (d)-[f:FAVORED_BY]->(s) SET f.boost=0.75;
MATCH (d:Disease {disease_id:"leaf_miner"}), (s:SeasonCondition {condition_id:"hot_dry"}) MERGE (d)-[f:FAVORED_BY]->(s) SET f.boost=0.6;
MERGE (d:Disease {disease_id:"leaf_mold"}) SET d.name_en="Leaf Mold", d.name_ta="இலைப் பூசண நோய்", d.type="fungal", d.severity_scale=3, d.contagious=true, d.source="jagtap2025", d.summary_en="Pale yellow patches on the upper leaf surface with olive-green velvety mould underneath. Thrives above 85% humidity, especially in poly-houses.", d.summary_ta="இலையின் மேல்புறம் வெளிர் மஞ்சள் திட்டுகள், அடியில் ஆலிவ் பச்சை வெல்வெட் போன்ற பூசணம். 85%-க்கு மேல் ஈரப்பதத்தில், குறிப்பாக பசுமைக்குடில்களில் அதிகம்.", d.prevention_en=["Improve ventilation; avoid overhead watering.", "Use certified or treated seed.", "Remove crop debris and sanitize the poly-house between seasons."], d.prevention_ta=["காற்றோட்டத்தை அதிகரிக்கவும்; மேலிருந்து நீர் தெளிக்க வேண்டாம்.", "சான்றளிக்கப்பட்ட / நேர்த்தி செய்த விதையைப் பயன்படுத்தவும்.", "பருவங்களுக்கிடையே கழிவுகளை அகற்றி பசுமைக்குடிலைச் சுத்தம் செய்யவும்."], d.images=["leaf_mold_1.jpg", "leaf_mold_2.jpg", "leaf_mold_3.jpg"];
MATCH (c:Crop {crop_id:"tomato"}), (d:Disease {disease_id:"leaf_mold"}) MERGE (c)-[:SUSCEPTIBLE_TO]->(d);
MATCH (d:Disease {disease_id:"leaf_mold"}), (s:SeasonCondition {condition_id:"humid_monsoon"}) MERGE (d)-[f:FAVORED_BY]->(s) SET f.boost=0.85;
MATCH (d:Disease {disease_id:"leaf_mold"}) MERGE (i:ConfirmationImage {image_id:"img_leaf_mold_1"}) SET i.url="/static/img/diseases/leaf_mold_1.jpg", i.disease_id="leaf_mold", i.verified_count=coalesce(i.verified_count,0) MERGE (d)-[:CONFIRMED_BY]->(i);
MATCH (d:Disease {disease_id:"leaf_mold"}) MERGE (i:ConfirmationImage {image_id:"img_leaf_mold_2"}) SET i.url="/static/img/diseases/leaf_mold_2.jpg", i.disease_id="leaf_mold", i.verified_count=coalesce(i.verified_count,0) MERGE (d)-[:CONFIRMED_BY]->(i);
MATCH (d:Disease {disease_id:"leaf_mold"}) MERGE (i:ConfirmationImage {image_id:"img_leaf_mold_3"}) SET i.url="/static/img/diseases/leaf_mold_3.jpg", i.disease_id="leaf_mold", i.verified_count=coalesce(i.verified_count,0) MERGE (d)-[:CONFIRMED_BY]->(i);
MERGE (d:Disease {disease_id:"target_spot"}) SET d.name_en="Target Spot", d.name_ta="இலக்குப் புள்ளி நோய்", d.type="fungal", d.severity_scale=4, d.contagious=true, d.source="jagtap2025", d.summary_en="Starts as pin-point water-soaked spots that grow into brown spots with target-like rings and yellow halos; causes heavy leaf drop in warm, humid weather.", d.summary_ta="குண்டூசி அளவு நனைந்த புள்ளிகளாகத் தொடங்கி, இலக்கு போன்ற வளையங்களும் மஞ்சள் விளிம்பும் கொண்ட பழுப்புப் புள்ளிகளாக வளரும்; வெப்பமான ஈரக் காலத்தில் இலைகள் அதிகமாக உதிரும்.", d.prevention_en=["Remove old plant debris after harvest.", "Do not plant tomato, chilli, brinjal or potato in the same spot for 3 years.", "Rotate fungicide groups; no more than two consecutive azoxystrobin sprays."], d.prevention_ta=["அறுவடைக்குப் பின் பழைய செடிக் கழிவுகளை அகற்றவும்.", "ஒரே இடத்தில் 3 ஆண்டுகளுக்கு தக்காளி, மிளகாய், கத்தரி, உருளைக்கிழங்கு பயிரிட வேண்டாம்.", "பூஞ்சைக் கொல்லிகளை மாற்றி மாற்றிப் பயன்படுத்தவும்; அசாக்ஸிஸ்ட்ரோபினைத் தொடர்ந்து இரண்டு முறைக்கு மேல் தெளிக்க வேண்டாம்."], d.images=["target_spot_1.jpg", "target_spot_2.jpg", "target_spot_3.jpg"];
MATCH (c:Crop {crop_id:"tomato"}), (d:Disease {disease_id:"target_spot"}) MERGE (c)-[:SUSCEPTIBLE_TO]->(d);
MATCH (d:Disease {disease_id:"target_spot"}), (s:SeasonCondition {condition_id:"humid_monsoon"}) MERGE (d)-[f:FAVORED_BY]->(s) SET f.boost=0.8;
MATCH (d:Disease {disease_id:"target_spot"}) MERGE (i:ConfirmationImage {image_id:"img_target_spot_1"}) SET i.url="/static/img/diseases/target_spot_1.jpg", i.disease_id="target_spot", i.verified_count=coalesce(i.verified_count,0) MERGE (d)-[:CONFIRMED_BY]->(i);
MATCH (d:Disease {disease_id:"target_spot"}) MERGE (i:ConfirmationImage {image_id:"img_target_spot_2"}) SET i.url="/static/img/diseases/target_spot_2.jpg", i.disease_id="target_spot", i.verified_count=coalesce(i.verified_count,0) MERGE (d)-[:CONFIRMED_BY]->(i);
MATCH (d:Disease {disease_id:"target_spot"}) MERGE (i:ConfirmationImage {image_id:"img_target_spot_3"}) SET i.url="/static/img/diseases/target_spot_3.jpg", i.disease_id="target_spot", i.verified_count=coalesce(i.verified_count,0) MERGE (d)-[:CONFIRMED_BY]->(i);
MERGE (s:Symptom {symptom_id:"leaf_spots"}) SET s.part="leaf", s.group="spots", s.cost=0, s.label_en="Spots on the leaves", s.label_ta="இலைகளில் புள்ளிகள்", s.description_en="Spots on the leaves", s.question_en="Are there spots on the leaves?", s.question_ta="இலைகளில் புள்ளிகள் உள்ளனவா?";
MERGE (s:Symptom {symptom_id:"ring_spots"}) SET s.part="leaf", s.group="spots", s.cost=0, s.label_en="Brown–black spots with rings inside (like a target)", s.label_ta="வளையம் வளையமாக (இலக்கு போல) பழுப்பு-கருப்புப் புள்ளிகள்", s.description_en="Brown–black spots with rings inside (like a target)", s.question_en="Do the spots on the leaves have rings inside them, like a target?", s.question_ta="இலையில் உள்ள புள்ளிகளுக்குள் இலக்கு போல வளையங்கள் தெரிகிறதா?";
MERGE (s:Symptom {symptom_id:"yellow_halo"}) SET s.part="leaf", s.group="spots", s.cost=0, s.label_en="Yellow ring (halo) around the spots", s.label_ta="புள்ளிகளைச் சுற்றி மஞ்சள் வளையம்", s.description_en="Yellow ring (halo) around the spots", s.question_en="Is there a yellow ring around the spots?", s.question_ta="புள்ளிகளைச் சுற்றி மஞ்சள் நிற வளையம் இருக்கிறதா?";
MERGE (s:Symptom {symptom_id:"starts_lower_leaves"}) SET s.part="leaf", s.group="pattern", s.cost=0, s.label_en="Problem started on the older, lower leaves", s.label_ta="பிரச்சனை முதலில் கீழ் (பழைய) இலைகளில் தொடங்கியது", s.description_en="Problem started on the older, lower leaves", s.question_en="Did the problem start on the lower, older leaves first?", s.question_ta="முதலில் கீழே உள்ள பழைய இலைகளில்தான் தொடங்கியதா?";
MERGE (s:Symptom {symptom_id:"small_grey_spots"}) SET s.part="leaf", s.group="spots", s.cost=0, s.label_en="Many small round spots with grey centre and dark border", s.label_ta="சாம்பல் நடுப்பகுதியும் கருப்பு ஓரமும் கொண்ட பல சிறிய வட்டப் புள்ளிகள்", s.description_en="Many small round spots with grey centre and dark border", s.question_en="Are there many small round spots with a grey centre and a dark edge?", s.question_ta="நடுவில் சாம்பல் நிறமும் ஓரத்தில் கருப்பும் உள்ள பல சிறிய வட்டப் புள்ளிகள் உள்ளனவா?";
MERGE (s:Symptom {symptom_id:"black_dots_in_spots"}) SET s.part="leaf", s.group="spots", s.cost=0, s.label_en="Tiny black dots inside the spots", s.label_ta="புள்ளிகளுக்குள் மிகச் சிறிய கருப்புப் பொட்டுகள்", s.description_en="Tiny black dots inside the spots", s.question_en="Looking closely, are there tiny black dots in the centre of the spots?", s.question_ta="உற்றுப் பார்த்தால், புள்ளிகளின் நடுவில் மிகச் சிறிய கருப்புப் பொட்டுகள் தெரிகிறதா?";
MERGE (s:Symptom {symptom_id:"water_soaked_patches"}) SET s.part="leaf", s.group="spots", s.cost=0, s.label_en="Large dark, water-soaked (greasy-looking) patches on leaves", s.label_ta="இலையில் நனைந்தது போன்ற பெரிய கருமையான திட்டுகள்", s.description_en="Large dark, water-soaked (greasy-looking) patches on leaves", s.question_en="Are there large dark patches on the leaves that look wet or greasy?", s.question_ta="இலையில் நனைந்தது போல் தோன்றும் பெரிய கருமையான திட்டுகள் உள்ளனவா?";
MERGE (s:Symptom {symptom_id:"fast_spread"}) SET s.part="plant", s.group="pattern", s.cost=0, s.label_en="Spreads very fast — many plants affected within days", s.label_ta="சில நாட்களில் பல செடிகளுக்கு வேகமாகப் பரவுகிறது", s.description_en="Spreads very fast — many plants affected within days", s.question_en="Has it spread to many plants within a few days?", s.question_ta="சில நாட்களுக்குள் பல செடிகளுக்குப் பரவிவிட்டதா?";
MERGE (s:Symptom {symptom_id:"white_growth_underside"}) SET s.part="leaf", s.group="fungus", s.cost=0, s.label_en="White fuzzy growth under the leaf (morning / humid)", s.label_ta="இலையின் அடியில் வெள்ளை பஞ்சு போன்ற பூஞ்சை வளர்ச்சி", s.description_en="White fuzzy growth under the leaf (morning / humid)", s.question_en="Is there white fuzzy growth on the underside of the leaves, especially in the morning?", s.question_ta="இலையின் அடிப்பகுதியில், குறிப்பாகக் காலையில், வெள்ளை பஞ்சு போன்ற வளர்ச்சி தெரிகிறதா?";
MERGE (s:Symptom {symptom_id:"olive_mold_underside"}) SET s.part="leaf", s.group="fungus", s.cost=0, s.label_en="Olive-green / brown velvety mould under the leaf", s.label_ta="இலையின் அடியில் ஆலிவ் பச்சை / பழுப்பு வெல்வெட் போன்ற பூசணம்", s.description_en="Olive-green / brown velvety mould under the leaf", s.question_en="Is there olive-green or brown velvety mould on the underside of the leaves?", s.question_ta="இலையின் அடியில் பச்சை-பழுப்பு நிற வெல்வெட் போன்ற பூசணம் இருக்கிறதா?";
MERGE (s:Symptom {symptom_id:"pale_yellow_patches"}) SET s.part="leaf", s.group="colour", s.cost=0, s.label_en="Pale yellow patches (no sharp edge) on the upper leaf surface", s.label_ta="இலையின் மேல்புறத்தில் தெளிவான ஓரமில்லாத வெளிர் மஞ்சள் திட்டுகள்", s.description_en="Pale yellow patches (no sharp edge) on the upper leaf surface", s.question_en="Are there pale yellow patches without sharp edges on the upper side of the leaves?", s.question_ta="இலையின் மேல்புறத்தில் தெளிவான ஓரமில்லாத வெளிர் மஞ்சள் திட்டுகள் உள்ளனவா?";
MERGE (s:Symptom {symptom_id:"tiny_water_soaked_spots"}) SET s.part="leaf", s.group="spots", s.cost=0, s.label_en="Tiny dark water-soaked spots (pin-head size) that turn scabby", s.label_ta="குண்டூசித் தலை அளவிலான சிறிய கருமையான நனைந்த புள்ளிகள்", s.description_en="Tiny dark water-soaked spots (pin-head size) that turn scabby", s.question_en="Did it start as tiny, pin-head sized dark spots that looked wet?", s.question_ta="குண்டூசித் தலை அளவிலான, நனைந்தது போன்ற சிறிய கருப்புப் புள்ளிகளாகத் தொடங்கியதா?";
MERGE (s:Symptom {symptom_id:"white_powder"}) SET s.part="leaf", s.group="fungus", s.cost=0, s.label_en="White powdery coating on the leaf surface (rubs off)", s.label_ta="இலையின் மேல் தேய்த்தால் வரும் வெள்ளைத் தூள் படலம்", s.description_en="White powdery coating on the leaf surface (rubs off)", s.question_en="Is there a white powder on the leaf surface that rubs off with your finger?", s.question_ta="இலையின் மேல் விரலால் தேய்த்தால் வரும் வெள்ளைத் தூள் இருக்கிறதா?";
MERGE (s:Symptom {symptom_id:"insects_fly_up"}) SET s.part="pest", s.group="pests", s.cost=0, s.label_en="Tiny white insects fly up when the plant is shaken", s.label_ta="செடியை அசைத்தால் சிறிய வெள்ளைப் பூச்சிகள் பறக்கின்றன", s.description_en="Tiny white insects fly up when the plant is shaken", s.question_en="When you shake the plant, do tiny white insects fly up?", s.question_ta="செடியை அசைத்தால் சிறிய வெள்ளைப் பூச்சிகள் பறக்கின்றனவா?";
MERGE (s:Symptom {symptom_id:"sticky_sooty"}) SET s.part="leaf", s.group="pests", s.cost=0, s.label_en="Leaves sticky / shiny, with a black sooty coating", s.label_ta="இலை ஒட்டும் தன்மை, கருப்புக் கரி போன்ற படலம்", s.description_en="Leaves sticky / shiny, with a black sooty coating", s.question_en="Are the leaves sticky, or covered with a black sooty layer?", s.question_ta="இலைகள் ஒட்டும் தன்மையுடன் அல்லது கருப்புக் கரி போன்ற படலத்துடன் உள்ளனவா?";
MERGE (s:Symptom {symptom_id:"leaf_curl_up"}) SET s.part="leaf", s.group="shape", s.cost=0, s.label_en="Leaves curl upward / cup-shaped and become small", s.label_ta="இலைகள் மேல்நோக்கிச் சுருண்டு, சிறியதாகின்றன", s.description_en="Leaves curl upward / cup-shaped and become small", s.question_en="Are the leaves curling upward like a cup?", s.question_ta="இலைகள் கிண்ணம் போல மேல்நோக்கிச் சுருள்கின்றனவா?";
MERGE (s:Symptom {symptom_id:"yellow_young_leaves"}) SET s.part="leaf", s.group="colour", s.cost=0, s.label_en="Young (top) leaves turning yellow at edges / between veins", s.label_ta="இளம் (நுனி) இலைகள் ஓரங்களிலும் நரம்புகளுக்கு இடையிலும் மஞ்சளாகின்றன", s.description_en="Young (top) leaves turning yellow at edges / between veins", s.question_en="Are the young leaves at the top turning yellow, especially at the edges?", s.question_ta="நுனியில் உள்ள இளம் இலைகள், குறிப்பாக ஓரங்களில், மஞ்சளாகின்றனவா?";
MERGE (s:Symptom {symptom_id:"mosaic_mottling"}) SET s.part="leaf", s.group="colour", s.cost=0, s.label_en="Light and dark green mottled (mosaic) pattern", s.label_ta="இலையில் வெளிர் பச்சை – கரும்பச்சை கலந்த தேமல்", s.description_en="Light and dark green mottled (mosaic) pattern", s.question_en="Do the leaves have a patchy light-green and dark-green (mosaic) pattern?", s.question_ta="இலைகளில் வெளிர் பச்சையும் கரும்பச்சையும் கலந்த தேமல் போன்ற வடிவம் தெரிகிறதா?";
MERGE (s:Symptom {symptom_id:"leaf_deformed"}) SET s.part="leaf", s.group="shape", s.cost=0, s.label_en="Leaves twisted, narrow or deformed (fern-like)", s.label_ta="இலைகள் முறுக்கி, குறுகி, உருமாறி உள்ளன", s.description_en="Leaves twisted, narrow or deformed (fern-like)", s.question_en="Are the leaves twisted, narrow or oddly shaped?", s.question_ta="இலைகள் முறுக்கியோ, குறுகியோ, உருமாறியோ உள்ளனவா?";
MERGE (s:Symptom {symptom_id:"leaf_yellowing"}) SET s.part="leaf", s.group="colour", s.cost=0, s.label_en="Leaves turning yellow (in general)", s.label_ta="இலைகள் மஞ்சளாகின்றன", s.description_en="Leaves turning yellow (in general)", s.question_en="Are many leaves turning yellow?", s.question_ta="பல இலைகள் மஞ்சளாகின்றனவா?";
MERGE (s:Symptom {symptom_id:"fine_speckles"}) SET s.part="leaf", s.group="colour", s.cost=0, s.label_en="Tiny yellow/white speckles all over the leaf (stippling)", s.label_ta="இலை முழுவதும் மிகச் சிறிய மஞ்சள் / வெள்ளைப் பொட்டுகள்", s.description_en="Tiny yellow/white speckles all over the leaf (stippling)", s.question_en="Are there tiny yellow or white speckles all over the leaves?", s.question_ta="இலை முழுவதும் மிகச் சிறிய மஞ்சள் அல்லது வெள்ளைப் பொட்டுகள் உள்ளனவா?";
MERGE (s:Symptom {symptom_id:"webbing"}) SET s.part="pest", s.group="pests", s.cost=0, s.label_en="Fine web under or between the leaves", s.label_ta="இலையின் அடியில் / இலைகளுக்கு இடையில் மெல்லிய சிலந்தி வலை", s.description_en="Fine web under or between the leaves", s.question_en="Is there fine web on the underside of the leaves or between them?", s.question_ta="இலையின் அடியில் அல்லது இலைகளுக்கு இடையில் மெல்லிய வலை தெரிகிறதா?";
MERGE (s:Symptom {symptom_id:"bronze_dry_leaves"}) SET s.part="leaf", s.group="colour", s.cost=0, s.label_en="Leaves turn bronze / silvery and dry up", s.label_ta="இலைகள் வெண்கல / வெள்ளி நிறமாகிக் காய்ந்துவிடுகின்றன", s.description_en="Leaves turn bronze / silvery and dry up", s.question_en="Do the leaves look bronze or silvery and dry?", s.question_ta="இலைகள் வெண்கல அல்லது வெள்ளி நிறமாகிக் காய்ந்து காணப்படுகின்றனவா?";
MERGE (s:Symptom {symptom_id:"leaf_tunnels"}) SET s.part="leaf", s.group="pests", s.cost=0, s.label_en="Winding white/brown tunnel lines inside the leaf", s.label_ta="இலைக்குள் வளைந்து செல்லும் வெள்ளை / பழுப்புச் சுரங்கக் கோடுகள்", s.description_en="Winding white/brown tunnel lines inside the leaf", s.question_en="Are there winding white or brown lines (tunnels) inside the leaves?", s.question_ta="இலைக்குள் வளைந்து செல்லும் வெள்ளை அல்லது பழுப்புக் கோடுகள் (சுரங்கம்) உள்ளனவா?";
MERGE (s:Symptom {symptom_id:"leaves_drop"}) SET s.part="leaf", s.group="pattern", s.cost=0, s.label_en="Leaves dry and fall off", s.label_ta="இலைகள் காய்ந்து உதிர்கின்றன", s.description_en="Leaves dry and fall off", s.question_en="Are leaves drying up and falling off?", s.question_ta="இலைகள் காய்ந்து உதிர்கின்றனவா?";
MERGE (s:Symptom {symptom_id:"one_side_wilt"}) SET s.part="plant", s.group="wilt", s.cost=0, s.label_en="Wilting starts on one side / one branch, lower leaves yellow", s.label_ta="செடியின் ஒரு பக்கம் / ஒரு கிளை மட்டும் வாடுகிறது", s.description_en="Wilting starts on one side / one branch, lower leaves yellow", s.question_en="Is only one side or one branch of the plant wilting?", s.question_ta="செடியின் ஒரு பக்கம் அல்லது ஒரு கிளை மட்டும் வாடுகிறதா?";
MERGE (s:Symptom {symptom_id:"sudden_wilt_green"}) SET s.part="plant", s.group="wilt", s.cost=0, s.label_en="Whole plant suddenly wilts while leaves are still green", s.label_ta="இலைகள் பச்சையாக இருக்கும்போதே செடி முழுவதும் திடீரென வாடுகிறது", s.description_en="Whole plant suddenly wilts while leaves are still green", s.question_en="Did the whole plant wilt suddenly while the leaves were still green?", s.question_ta="இலைகள் பச்சையாக இருக்கும்போதே செடி முழுவதும் திடீரென வாடியதா?";
MERGE (s:Symptom {symptom_id:"wilt_recovers_night"}) SET s.part="plant", s.group="wilt", s.cost=0, s.label_en="Wilts in afternoon heat, recovers at night", s.label_ta="மதிய வெயிலில் வாடி, இரவில் மீண்டும் சரியாகிறது", s.description_en="Wilts in afternoon heat, recovers at night", s.question_en="Does the plant wilt in the afternoon heat and recover by night?", s.question_ta="செடி மதிய வெயிலில் வாடி, இரவில் மீண்டும் சரியாகிறதா?";
MERGE (s:Symptom {symptom_id:"brown_inside_stem"}) SET s.part="stem", s.group="stem_root", s.cost=0.1, s.label_en="Brown streaks inside the stem when cut", s.label_ta="தண்டை வெட்டினால் உள்ளே பழுப்பு நிறக் கோடுகள்", s.description_en="Brown streaks inside the stem when cut", s.question_en="If you cut a wilted stem lengthwise, is it brown inside?", s.question_ta="வாடிய தண்டை நீளவாக்கில் வெட்டினால் உள்ளே பழுப்பு நிறமாக இருக்கிறதா?";
MERGE (s:Symptom {symptom_id:"white_ooze"}) SET s.part="stem", s.group="stem_root", s.cost=0.15, s.label_en="Milky white ooze when a cut stem is dipped in water", s.label_ta="வெட்டிய தண்டை தண்ணீரில் வைத்தால் பால் போன்ற வெள்ளைக் கசிவு", s.description_en="Milky white ooze when a cut stem is dipped in water", s.question_en="Cut a wilted stem and dip it in a glass of clear water. Does a milky white liquid stream out within a few minutes?", s.question_ta="வாடிய தண்டை வெட்டி ஒரு டம்ளர் தெளிந்த நீரில் வையுங்கள். சில நிமிடங்களில் பால் போன்ற வெள்ளைத் திரவம் வருகிறதா?";
MERGE (s:Symptom {symptom_id:"stem_lesions"}) SET s.part="stem", s.group="stem_root", s.cost=0, s.label_en="Dark brown / black patches on the stem", s.label_ta="தண்டில் கருமையான பழுப்பு / கருப்புத் திட்டுகள்", s.description_en="Dark brown / black patches on the stem", s.question_en="Are there dark brown or black patches on the stem?", s.question_ta="தண்டில் கருமையான பழுப்பு அல்லது கருப்புத் திட்டுகள் உள்ளனவா?";
MERGE (s:Symptom {symptom_id:"stunted"}) SET s.part="plant", s.group="growth", s.cost=0, s.label_en="Plant stunted / bushy, not growing well", s.label_ta="செடி குட்டையாக, புதர் போல, சரியாக வளரவில்லை", s.description_en="Plant stunted / bushy, not growing well", s.question_en="Is the plant stunted or bushy and not growing well?", s.question_ta="செடி குட்டையாக, புதர் போல, சரியாக வளராமல் உள்ளதா?";
MERGE (s:Symptom {symptom_id:"root_galls"}) SET s.part="root", s.group="stem_root", s.cost=0.25, s.label_en="Knots / swellings on the roots", s.label_ta="வேரில் முடிச்சுகள் / கட்டிகள்", s.description_en="Knots / swellings on the roots", s.question_en="If you pull out one affected plant, are there knots or swellings on the roots?", s.question_ta="பாதித்த ஒரு செடியைப் பிடுங்கிப் பார்த்தால், வேரில் முடிச்சுகள் அல்லது கட்டிகள் உள்ளனவா?";
MERGE (s:Symptom {symptom_id:"flower_drop"}) SET s.part="flower", s.group="growth", s.cost=0, s.label_en="Flowers drop off, few fruits set", s.label_ta="பூக்கள் உதிர்கின்றன, காய் பிடிப்பு குறைவு", s.description_en="Flowers drop off, few fruits set", s.question_en="Are flowers falling off without setting fruit?", s.question_ta="பூக்கள் காய் பிடிக்காமல் உதிர்கின்றனவா?";
MERGE (s:Symptom {symptom_id:"fruit_bottom_rot"}) SET s.part="fruit", s.group="fruit", s.cost=0, s.label_en="Dark, sunken, leathery patch at the bottom of the fruit", s.label_ta="பழத்தின் அடிப்பகுதியில் கருப்பான, குழிந்த, தோல் போன்ற திட்டு", s.description_en="Dark, sunken, leathery patch at the bottom of the fruit", s.question_en="Is there a dark, sunken, leathery patch at the bottom (flower end) of the fruit?", s.question_ta="பழத்தின் அடிப்பகுதியில் (பூ இருந்த இடத்தில்) கருப்பான, குழிந்த, தோல் போன்ற திட்டு உள்ளதா?";
MERGE (s:Symptom {symptom_id:"fruit_holes"}) SET s.part="fruit", s.group="fruit", s.cost=0, s.label_en="Round holes in the fruit, sometimes with a caterpillar inside", s.label_ta="பழத்தில் வட்டமான துளைகள், உள்ளே புழு", s.description_en="Round holes in the fruit, sometimes with a caterpillar inside", s.question_en="Are there round holes in the fruits?", s.question_ta="காய்களில் வட்டமான துளைகள் உள்ளனவா?";
MERGE (s:Symptom {symptom_id:"caterpillar_seen"}) SET s.part="pest", s.group="pests", s.cost=0, s.label_en="Green / brown caterpillars on the plant or fruit", s.label_ta="செடியில் / பழத்தில் பச்சை அல்லது பழுப்பு நிறப் புழுக்கள்", s.description_en="Green / brown caterpillars on the plant or fruit", s.question_en="Can you see green or brown caterpillars on the plant or fruits?", s.question_ta="செடியிலோ காய்களிலோ பச்சை அல்லது பழுப்பு நிறப் புழுக்கள் தெரிகின்றனவா?";
MERGE (s:Symptom {symptom_id:"greasy_fruit_patches"}) SET s.part="fruit", s.group="fruit", s.cost=0, s.label_en="Large firm greasy-brown patches on green fruit", s.label_ta="பச்சைக் காயில் பெரிய, கெட்டியான, எண்ணெய் தடவியது போன்ற பழுப்புத் திட்டுகள்", s.description_en="Large firm greasy-brown patches on green fruit", s.question_en="Are there large, firm, greasy-looking brown patches on the green fruits?", s.question_ta="பச்சைக் காய்களில் எண்ணெய் தடவியது போன்ற பெரிய, கெட்டியான பழுப்புத் திட்டுகள் உள்ளனவா?";
MERGE (s:Symptom {symptom_id:"scabby_fruit_spots"}) SET s.part="fruit", s.group="fruit", s.cost=0, s.label_en="Small raised scabby dark spots on the fruit", s.label_ta="பழத்தில் சிறிய, மேடான, சொரசொரப்பான கருப்புப் புள்ளிகள்", s.description_en="Small raised scabby dark spots on the fruit", s.question_en="Are there small, raised, rough dark spots on the fruits?", s.question_ta="காய்களில் சிறிய, மேடான, சொரசொரப்பான கருப்புப் புள்ளிகள் உள்ளனவா?";
MERGE (s:Symptom {symptom_id:"fruit_stem_end_rot"}) SET s.part="fruit", s.group="fruit", s.cost=0, s.label_en="Dark sunken spots with rings near the fruit stalk", s.label_ta="பழக் காம்பு அருகே வளையங்களுடன் கருமையான குழிந்த புள்ளிகள்", s.description_en="Dark sunken spots with rings near the fruit stalk", s.question_en="Are there dark sunken spots with rings near the stalk end of the fruit?", s.question_ta="பழக் காம்பு அருகே வளையங்களுடன் கருமையான குழிந்த புள்ளிகள் உள்ளனவா?";
MERGE (s:Symptom {symptom_id:"uneven_ripening"}) SET s.part="fruit", s.group="fruit", s.cost=0, s.label_en="Uneven, blotchy ripening of fruits", s.label_ta="பழம் சீராகப் பழுக்காமல் திட்டுத் திட்டாக நிறம்", s.description_en="Uneven, blotchy ripening of fruits", s.question_en="Are the fruits ripening unevenly, in blotches?", s.question_ta="பழங்கள் சீராகப் பழுக்காமல் திட்டுத் திட்டாக நிறம் மாறுகின்றனவா?";
MERGE (s:Symptom {symptom_id:"small_fruits_low_yield"}) SET s.part="fruit", s.group="growth", s.cost=0, s.label_en="Fruits small and fewer than usual", s.label_ta="காய்கள் சிறியதாகவும் குறைவாகவும் உள்ளன", s.description_en="Fruits small and fewer than usual", s.question_en="Are the fruits smaller and fewer than usual?", s.question_ta="காய்கள் வழக்கத்தை விடச் சிறியதாகவும் குறைவாகவும் உள்ளனவா?";
MERGE (s:Symptom {symptom_id:"plant_wilting"}) SET s.part="plant", s.group="wilt", s.cost=0, s.label_en="Plant wilting / drooping", s.label_ta="செடி வாடித் தொங்குகிறது", s.description_en="Plant wilting / drooping", s.question_en="Is the plant wilting or drooping?", s.question_ta="செடி வாடித் தொங்குகிறதா?";
MERGE (s:Symptom {symptom_id:"fruit_rot"}) SET s.part="fruit", s.group="fruit", s.cost=0, s.label_en="Fruits rotting / spoiling", s.label_ta="காய்கள் அழுகுகின்றன", s.description_en="Fruits rotting / spoiling", s.question_en="Are the fruits rotting or spoiling?", s.question_ta="காய்கள் அழுகுகின்றனவா?";
MERGE (s:Symptom {symptom_id:"pests_seen"}) SET s.part="pest", s.group="pests", s.cost=0, s.label_en="Insects / pests seen on the plant", s.label_ta="செடியில் பூச்சிகள் தென்படுகின்றன", s.description_en="Insects / pests seen on the plant", s.question_en="Do you see any insects, mites or caterpillars on the plant?", s.question_ta="செடியில் ஏதாவது பூச்சி, பேன் அல்லது புழு தெரிகிறதா?";
