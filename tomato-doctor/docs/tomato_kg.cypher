MATCH (d:Disease {disease_id:"late_blight"}), (s:Symptom {symptom_id:"plant_wilting"}) MERGE (d)-[h:HAS_SYMPTOM]->(s) ON CREATE SET h.weight=0.2, h.seed_weight=0.2, h.alpha=4.0000, h.beta=16.0000;
MATCH (d:Disease {disease_id:"spider_mite"}), (s:Symptom {symptom_id:"plant_wilting"}) MERGE (d)-[h:HAS_SYMPTOM]->(s) ON CREATE SET h.weight=0.15, h.seed_weight=0.15, h.alpha=3.0000, h.beta=17.0000;
MATCH (d:Disease {disease_id:"blossom_end_rot"}), (s:Symptom {symptom_id:"fruit_rot"}) MERGE (d)-[h:HAS_SYMPTOM]->(s) ON CREATE SET h.weight=0.8, h.seed_weight=0.8, h.alpha=16.0000, h.beta=4.0000;
MATCH (d:Disease {disease_id:"late_blight"}), (s:Symptom {symptom_id:"fruit_rot"}) MERGE (d)-[h:HAS_SYMPTOM]->(s) ON CREATE SET h.weight=0.5, h.seed_weight=0.5, h.alpha=10.0000, h.beta=10.0000;
MATCH (d:Disease {disease_id:"fruit_borer"}), (s:Symptom {symptom_id:"fruit_rot"}) MERGE (d)-[h:HAS_SYMPTOM]->(s) ON CREATE SET h.weight=0.45, h.seed_weight=0.45, h.alpha=9.0000, h.beta=11.0000;
MATCH (d:Disease {disease_id:"bacterial_spot"}), (s:Symptom {symptom_id:"fruit_rot"}) MERGE (d)-[h:HAS_SYMPTOM]->(s) ON CREATE SET h.weight=0.25, h.seed_weight=0.25, h.alpha=5.0000, h.beta=15.0000;
MATCH (d:Disease {disease_id:"early_blight"}), (s:Symptom {symptom_id:"fruit_rot"}) MERGE (d)-[h:HAS_SYMPTOM]->(s) ON CREATE SET h.weight=0.2, h.seed_weight=0.2, h.alpha=4.0000, h.beta=16.0000;
MATCH (d:Disease {disease_id:"target_spot"}), (s:Symptom {symptom_id:"fruit_rot"}) MERGE (d)-[h:HAS_SYMPTOM]->(s) ON CREATE SET h.weight=0.25, h.seed_weight=0.25, h.alpha=5.0000, h.beta=15.0000;
MATCH (d:Disease {disease_id:"whitefly"}), (s:Symptom {symptom_id:"pests_seen"}) MERGE (d)-[h:HAS_SYMPTOM]->(s) ON CREATE SET h.weight=0.95, h.seed_weight=0.95, h.alpha=19.0000, h.beta=1.0000;
MATCH (d:Disease {disease_id:"fruit_borer"}), (s:Symptom {symptom_id:"pests_seen"}) MERGE (d)-[h:HAS_SYMPTOM]->(s) ON CREATE SET h.weight=0.7, h.seed_weight=0.7, h.alpha=14.0000, h.beta=6.0000;
MATCH (d:Disease {disease_id:"spider_mite"}), (s:Symptom {symptom_id:"pests_seen"}) MERGE (d)-[h:HAS_SYMPTOM]->(s) ON CREATE SET h.weight=0.6, h.seed_weight=0.6, h.alpha=12.0000, h.beta=8.0000;
MATCH (d:Disease {disease_id:"leaf_miner"}), (s:Symptom {symptom_id:"pests_seen"}) MERGE (d)-[h:HAS_SYMPTOM]->(s) ON CREATE SET h.weight=0.5, h.seed_weight=0.5, h.alpha=10.0000, h.beta=10.0000;
MATCH (d:Disease {disease_id:"leaf_curl_virus"}), (s:Symptom {symptom_id:"pests_seen"}) MERGE (d)-[h:HAS_SYMPTOM]->(s) ON CREATE SET h.weight=0.45, h.seed_weight=0.45, h.alpha=9.0000, h.beta=11.0000;
MERGE (t:Treatment {treatment_id:"mancozeb_75wp"}) SET t.name_en="Mancozeb 75% WP", t.name_ta="மேன்கோசெப் 75% WP", t.type="chemical", t.dosage="3 g per litre of water", t.dosage_en="3 g per litre of water", t.dosage_ta="ஒரு லிட்டர் தண்ணீருக்கு 3 கிராம்", t.source="jagtap2025";
MERGE (t:Treatment {treatment_id:"copper_hydroxide"}) SET t.name_en="Copper Hydroxide 53.8% DF", t.name_ta="காப்பர் ஹைட்ராக்சைடு 53.8% DF", t.type="chemical", t.dosage="2 g per litre; every 10 days from the first spots", t.dosage_en="2 g per litre; every 10 days from the first spots", t.dosage_ta="லிட்டருக்கு 2 கிராம்; முதல் புள்ளிகள் தெரிந்தது முதல் 10 நாளுக்கு ஒருமுறை", t.source="jagtap2025";
MERGE (t:Treatment {treatment_id:"copper_oxychloride"}) SET t.name_en="Copper Oxychloride 50% WP", t.name_ta="காப்பர் ஆக்ஸிகுளோரைடு 50% WP", t.type="chemical", t.dosage="1–2 g per litre; repeat every 7–10 days", t.dosage_en="1–2 g per litre; repeat every 7–10 days", t.dosage_ta="லிட்டருக்கு 1–2 கிராம்; 7–10 நாளுக்கு ஒருமுறை", t.source="jagtap2025";
MERGE (t:Treatment {treatment_id:"cyazofamid"}) SET t.name_en="Cyazofamid 34.5% SC", t.name_ta="சயசோஃபாமிட் 34.5% SC", t.type="chemical", t.dosage="80 ml per acre", t.dosage_en="80 ml per acre", t.dosage_ta="ஏக்கருக்கு 80 மி.லி.", t.source="jagtap2025";
MERGE (t:Treatment {treatment_id:"azoxy_difeno"}) SET t.name_en="Azoxystrobin 18.2% + Difenoconazole 11.4% SC", t.name_ta="அசாக்ஸிஸ்ட்ரோபின் 18.2% + டைஃபெனோகோனசோல் 11.4% SC", t.type="chemical", t.dosage="200 ml per acre", t.dosage_en="200 ml per acre", t.dosage_ta="ஏக்கருக்கு 200 மி.லி.", t.source="jagtap2025";
MERGE (t:Treatment {treatment_id:"azoxystrobin_sc"}) SET t.name_en="Azoxystrobin 250 g/L SC", t.name_ta="அசாக்ஸிஸ்ட்ரோபின் 250 SC", t.type="chemical", t.dosage="10 ml per 10 litres; not more than 2 sprays in a row", t.dosage_en="10 ml per 10 litres; not more than 2 sprays in a row", t.dosage_ta="10 லிட்டருக்கு 10 மி.லி.; தொடர்ந்து 2 முறைக்கு மேல் தெளிக்க வேண்டாம்", t.source="jagtap2025";
MERGE (t:Treatment {treatment_id:"neonicotinoid"}) SET t.name_en="Neonicotinoid insecticide (controls whitefly vector)", t.name_ta="நியோனிகோட்டினாய்டு பூச்சிக்கொல்லி (வெள்ளை ஈ கட்டுப்பாடு)", t.type="chemical", t.dosage="0.75–1 ml per litre, as per product label", t.dosage_en="0.75–1 ml per litre, as per product label", t.dosage_ta="லிட்டருக்கு 0.75–1 மி.லி. (பொருளின் லேபிள் படி)", t.source="jagtap2025";
MERGE (t:Treatment {treatment_id:"diamide"}) SET t.name_en="Diamide insecticide", t.name_ta="டயமைடு பூச்சிக்கொல்லி", t.type="chemical", t.dosage="1.7–2.0 ml per litre", t.dosage_en="1.7–2.0 ml per litre", t.dosage_ta="லிட்டருக்கு 1.7–2.0 மி.லி.", t.source="jagtap2025";
MERGE (t:Treatment {treatment_id:"calcium_spray"}) SET t.name_en="Calcium chloride foliar spray", t.name_ta="கால்சியம் குளோரைடு இலைத் தெளிப்பு", t.type="chemical", t.dosage="5 g per litre, every 10 days during fruiting", t.dosage_en="5 g per litre, every 10 days during fruiting", t.dosage_ta="லிட்டருக்கு 5 கிராம், காய்ப் பருவத்தில் 10 நாளுக்கு ஒருமுறை", t.source="general";
MERGE (t:Treatment {treatment_id:"seed_treatment_naocl"}) SET t.name_en="Seed treatment: 1% sodium hypochlorite", t.name_ta="விதை நேர்த்தி: 1% சோடியம் ஹைப்போகுளோரைட்", t.type="chemical", t.dosage="Soak seeds for 10 minutes before sowing (next crop)", t.dosage_en="Soak seeds for 10 minutes before sowing (next crop)", t.dosage_ta="விதைப்பதற்கு முன் 10 நிமிடம் ஊறவைக்கவும் (அடுத்த பயிருக்கு)", t.source="jagtap2025";
MERGE (t:Treatment {treatment_id:"trichoderma"}) SET t.name_en="Trichoderma asperellum (soil application)", t.name_ta="டிரைக்கோடெர்மா (மண்ணில் இடுதல்)", t.type="organic", t.dosage="1 kg per acre", t.dosage_en="1 kg per acre", t.dosage_ta="ஏக்கருக்கு 1 கிலோ", t.source="jagtap2025";
MERGE (t:Treatment {treatment_id:"pseudomonas_bacillus"}) SET t.name_en="Pseudomonas fluorescens + Bacillus subtilis", t.name_ta="சூடோமோனாஸ் + பேசில்லஸ் சப்டிலிஸ்", t.type="organic", t.dosage="Spray 5–10 g per litre; soil: 5 kg mixed with 100 kg farmyard manure per acre", t.dosage_en="Spray 5–10 g per litre; soil: 5 kg mixed with 100 kg farmyard manure per acre", t.dosage_ta="தெளிப்பு: லிட்டருக்கு 5–10 கிராம்; மண்: ஏக்கருக்கு 5 கிலோ + 100 கிலோ தொழு உரம்", t.source="jagtap2025";
MERGE (t:Treatment {treatment_id:"bacillus_subtilis"}) SET t.name_en="Bacillus subtilis (strain QST 713)", t.name_ta="பேசில்லஸ் சப்டிலிஸ் (QST 713)", t.type="organic", t.dosage="4.5 kg per hectare", t.dosage_en="4.5 kg per hectare", t.dosage_ta="ஹெக்டேருக்கு 4.5 கிலோ", t.source="jagtap2025";
MERGE (t:Treatment {treatment_id:"wettable_sulfur"}) SET t.name_en="Wettable sulfur", t.name_ta="நனையும் கந்தகம்", t.type="organic", t.dosage="2 g per litre, weekly (do not spray in heat above 32°C)", t.dosage_en="2 g per litre, weekly (do not spray in heat above 32°C)", t.dosage_ta="லிட்டருக்கு 2 கிராம், வாரம் ஒருமுறை (32°C-க்கு மேல் வெயிலில் தெளிக்க வேண்டாம்)", t.source="general";
MERGE (t:Treatment {treatment_id:"neem_oil"}) SET t.name_en="Neem oil", t.name_ta="வேப்ப எண்ணெய்", t.type="organic", t.dosage="5 ml per litre with a little soap, every 5–7 days", t.dosage_en="5 ml per litre with a little soap, every 5–7 days", t.dosage_ta="லிட்டருக்கு 5 மி.லி. + சிறிது சோப்பு, 5–7 நாளுக்கு ஒருமுறை", t.source="general";
MERGE (t:Treatment {treatment_id:"insecticidal_soap"}) SET t.name_en="Insecticidal soap", t.name_ta="பூச்சிக்கொல்லி சோப்புக் கரைசல்", t.type="organic", t.dosage="As per label; spray the leaf undersides", t.dosage_en="As per label; spray the leaf undersides", t.dosage_ta="லேபிள் படி; இலையின் அடிப்பகுதியில் தெளிக்கவும்", t.source="jagtap2025";
MERGE (t:Treatment {treatment_id:"chilli_extract"}) SET t.name_en="Chilli extract spray", t.name_ta="மிளகாய்க் கரைசல்", t.type="organic", t.dosage="Soak 20 g crushed chilli in 1 L water for a day, dilute in 5 L water; spray weekly", t.dosage_en="Soak 20 g crushed chilli in 1 L water for a day, dilute in 5 L water; spray weekly", t.dosage_ta="20 கிராம் இடித்த மிளகாயை 1 லிட்டர் நீரில் ஒரு நாள் ஊறவைத்து, 5 லிட்டர் நீரில் கலந்து வாரம் ஒருமுறை தெளிக்கவும்", t.source="jagtap2025";
MERGE (t:Treatment {treatment_id:"bt_spray"}) SET t.name_en="Bacillus thuringiensis (Bt)", t.name_ta="பேசில்லஸ் துரிஞ்சியென்சிஸ் (Bt)", t.type="organic", t.dosage="2 g per litre in the evening, every 5–7 days; best on young larvae", t.dosage_en="2 g per litre in the evening, every 5–7 days; best on young larvae", t.dosage_ta="லிட்டருக்கு 2 கிராம், மாலையில், 5–7 நாளுக்கு ஒருமுறை; இளம் புழுக்களுக்கு சிறந்தது", t.source="jagtap2025";
MERGE (t:Treatment {treatment_id:"yellow_sticky_traps"}) SET t.name_en="Yellow sticky traps", t.name_ta="மஞ்சள் ஒட்டும் பொறிகள்", t.type="cultural", t.dosage="10–15 traps per acre", t.dosage_en="10–15 traps per acre", t.dosage_ta="ஏக்கருக்கு 10–15 பொறிகள்", t.source="general";
MERGE (t:Treatment {treatment_id:"pheromone_traps"}) SET t.name_en="Pheromone traps", t.name_ta="இனக்கவர்ச்சிப் பொறிகள்", t.type="cultural", t.dosage="5 traps per acre; change the lure monthly", t.dosage_en="5 traps per acre; change the lure monthly", t.dosage_ta="ஏக்கருக்கு 5 பொறிகள்; மாதம் ஒருமுறை கவர்ச்சிப் பொருளை மாற்றவும்", t.source="general";
MERGE (t:Treatment {treatment_id:"remove_destroy_plants"}) SET t.name_en="Uproot and destroy infected plants", t.name_ta="பாதித்த செடிகளைப் பிடுங்கி அழித்தல்", t.type="cultural", t.dosage="Immediately; burn or bury away from the field", t.dosage_en="Immediately; burn or bury away from the field", t.dosage_ta="உடனடியாக; வயலுக்கு வெளியே எரிக்கவும் அல்லது புதைக்கவும்", t.source="general";
MERGE (t:Treatment {treatment_id:"remove_infected_leaves"}) SET t.name_en="Prune infected / lower leaves", t.name_ta="பாதித்த / கீழ் இலைகளை அகற்றுதல்", t.type="cultural", t.dosage="Remove and destroy; do not compost", t.dosage_en="Remove and destroy; do not compost", t.dosage_ta="அகற்றி அழிக்கவும்; உரக்குழியில் போட வேண்டாம்", t.source="jagtap2025";
MERGE (t:Treatment {treatment_id:"collect_destroy"}) SET t.name_en="Collect and destroy bored fruits / mined leaves", t.name_ta="துளையுள்ள காய்கள் / சுரங்க இலைகளைச் சேகரித்து அழித்தல்", t.type="cultural", t.dosage="Every week", t.dosage_en="Every week", t.dosage_ta="வாரந்தோறும்", t.source="jagtap2025";
MERGE (t:Treatment {treatment_id:"drip_irrigation"}) SET t.name_en="Water at the base (drip); keep leaves dry", t.name_ta="சொட்டு நீர் — இலைகளை நனைக்காமல் வேரில் நீர்", t.type="cultural", t.dosage="Water early in the day", t.dosage_en="Water early in the day", t.dosage_ta="காலையில் நீர் பாய்ச்சவும்", t.source="jagtap2025";
MERGE (t:Treatment {treatment_id:"disinfect_hands_tools"}) SET t.name_en="Disinfect hands and tools", t.name_ta="கைகள், கருவிகளைக் கிருமி நீக்கம் செய்தல்", t.type="cultural", t.dosage="Wash with soap; dip tools in boiling water for 5 minutes", t.dosage_en="Wash with soap; dip tools in boiling water for 5 minutes", t.dosage_ta="சோப்பால் கழுவவும்; கருவிகளை 5 நிமிடம் கொதிநீரில் வைக்கவும்", t.source="jagtap2025";
MERGE (t:Treatment {treatment_id:"water_jet"}) SET t.name_en="Strong water spray on leaves", t.name_ta="இலைகளில் வேகமான நீர்த் தெளிப்பு", t.type="cultural", t.dosage="Early stage only — knocks mites off", t.dosage_en="Early stage only — knocks mites off", t.dosage_ta="ஆரம்ப நிலையில் மட்டும் — பேன்களை அகற்றும்", t.source="jagtap2025";
MERGE (t:Treatment {treatment_id:"crop_rotation"}) SET t.name_en="Crop rotation (2–3 seasons, non-solanaceous crops)", t.name_ta="பயிர் சுழற்சி (2–3 பருவம், தக்காளி குடும்பம் அல்லாத பயிர்கள்)", t.type="cultural", t.dosage="Next seasons: cereals, pulses or brassicas", t.dosage_en="Next seasons: cereals, pulses or brassicas", t.dosage_ta="அடுத்த பருவங்களில்: தானியங்கள், பயறு வகைகள், முட்டைக்கோஸ் வகைகள்", t.source="general";
MERGE (t:Treatment {treatment_id:"soil_solarization"}) SET t.name_en="Soil solarization", t.name_ta="மண் சூரியவெப்பச் சுத்திகரிப்பு", t.type="cultural", t.dosage="Cover moist soil with clear plastic for 4–6 weeks in peak summer", t.dosage_en="Cover moist soil with clear plastic for 4–6 weeks in peak summer", t.dosage_ta="கோடையில் ஈரமான மண்ணை 4–6 வாரம் ஒளி ஊடுருவும் பிளாஸ்டிக்கால் மூடவும்", t.source="general";
MERGE (t:Treatment {treatment_id:"even_watering_mulch"}) SET t.name_en="Even watering + mulching", t.name_ta="சீரான நீர்ப் பாசனம் + மூடாக்கு", t.type="cultural", t.dosage="Keep soil evenly moist; avoid wet–dry cycles", t.dosage_en="Keep soil evenly moist; avoid wet–dry cycles", t.dosage_ta="மண்ணைச் சீராக ஈரமாக வைக்கவும்; வறட்சி–அதிக நீர் மாறி மாறி வேண்டாம்", t.source="general";
MERGE (t:Treatment {treatment_id:"resistant_varieties"}) SET t.name_en="Resistant varieties", t.name_ta="நோய் எதிர்ப்பு ரகங்கள்", t.type="cultural", t.dosage="Use for the next crop", t.dosage_en="Use for the next crop", t.dosage_ta="அடுத்த பயிருக்குப் பயன்படுத்தவும்", t.source="jagtap2025";
MATCH (d:Disease {disease_id:"early_blight"}), (t:Treatment {treatment_id:"mancozeb_75wp"}) MERGE (d)-[x:TREATED_BY]->(t) SET x.efficacy=0.85;
MATCH (d:Disease {disease_id:"early_blight"}), (t:Treatment {treatment_id:"copper_hydroxide"}) MERGE (d)-[x:TREATED_BY]->(t) SET x.efficacy=0.8;
MATCH (d:Disease {disease_id:"early_blight"}), (t:Treatment {treatment_id:"pseudomonas_bacillus"}) MERGE (d)-[x:TREATED_BY]->(t) SET x.efficacy=0.65;
MATCH (d:Disease {disease_id:"early_blight"}), (t:Treatment {treatment_id:"remove_infected_leaves"}) MERGE (d)-[x:TREATED_BY]->(t) SET x.efficacy=0.6;
MATCH (d:Disease {disease_id:"early_blight"}), (t:Treatment {treatment_id:"drip_irrigation"}) MERGE (d)-[x:TREATED_BY]->(t) SET x.efficacy=0.5;
MATCH (d:Disease {disease_id:"late_blight"}), (t:Treatment {treatment_id:"cyazofamid"}) MERGE (d)-[x:TREATED_BY]->(t) SET x.efficacy=0.85;
MATCH (d:Disease {disease_id:"late_blight"}), (t:Treatment {treatment_id:"azoxy_difeno"}) MERGE (d)-[x:TREATED_BY]->(t) SET x.efficacy=0.8;
