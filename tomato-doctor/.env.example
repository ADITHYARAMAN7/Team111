# Copy to .env and fill in. Everything is optional - with no .env the app runs
# on the embedded knowledge graph (seed JSON + SQLite).

# auto = use Neo4j if reachable and seeded, else embedded | neo4j = require Neo4j | embedded = never use Neo4j
KG_BACKEND=auto

# Neo4j AuraDB (or local: bolt://localhost:7687)
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# NEO4J_DATABASE=

# Protects /expert when the app is reachable from other devices.
# If unset, the expert console only works from this computer.
EXPERT_TOKEN=

# HOST=0.0.0.0     # listen on the network (e.g. to open the app on a phone)
# PORT=5000

# Google Gemini - voice understanding (Tamil speech -> transcript + entities).
# Get a key at https://aistudio.google.com/apikey . Without it, voice falls back
# to the browser's speech recognition and the built-in Tamil/English matcher.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FOR_TEXT=1        # also use Gemini to understand typed descriptions

# Weather (Open-Meteo, no key needed). Set to 0 to disable location features.
# ENABLE_WEATHER=1
# OUTBREAK_RADIUS_KM=30
# OUTBREAK_DAYS=21
